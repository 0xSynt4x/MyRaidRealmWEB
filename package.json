{
  "name": "@1980s/nw-standalone",
  "private": true,
  "description": "Standalone 1980s-NW browser project. Builds a single self-contained dist/index.html.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "build:dev": "webpack --config webpack.1980s-nw-standalone.config.ts --mode development",
    "build": "webpack --config webpack.1980s-nw-standalone.config.ts --mode production",
    "watch": "webpack --config webpack.1980s-nw-standalone.config.ts --mode development --watch --progress",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write \"**/*.{ts,vue,css,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,css,scss,json,md}\"",
    "test": "node scripts/tests/run-standalone-local-content-tests.cjs"
  },
  "browserslist": ["defaults and partially supports es6-module"],
  "dependencies": {
    "@vueuse/core": "^13.9.0",
    "ejs": "^5.0.1",
    "klona": "^2.0.6",
    "pinia": "^3.0.4",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/jquery": "^3.5.34",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.10.0",
    "@types/toastr": "^2.1.43",
    "@types/webpack": "^5.28.5",
    "autoprefixer": "^10.4.27",
    "css-loader": "^7.1.4",
    "html-inline-css-webpack-plugin": "^1.11.2",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.6",
    "mini-css-extract-plugin": "^2.10.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.1",
    "postcss-minify": "^1.2.0",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "tailwindcss": "^4.2.1",
    "terser-webpack-plugin": "^5.3.16",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tslib": "^2.8.1",
    "type-fest": "^4.41.0",
    "typescript": "^5.8.3",
    "vue": "^3.5.29",
    "vue-loader": "^17.4.2",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1",
    "vue-tsc": "^2.2.10",
    "eslint": "^9.18.0",
    "@eslint/js": "^9.18.0",
    "typescript-eslint": "^8.20.0",
    "eslint-plugin-vue": "^9.32.0",
    "vue-eslint-parser": "^9.4.3",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2"
  }
}
